# ==========================================
# Klinik Hospital Management - Backend Config
# ==========================================
# NOTE: Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit the actual .env file to version control.

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Databases
# 1. MongoDB Connection URL (Primary / Document Store)
MONGODB_URI=mongodb://127.0.0.1:27017/klinik

# 2. PostgreSQL Connection URL (Prisma ORM)
DATABASE_URL=postgresql://postgres:password@localhost:5432/amar_raho_hospital?schema=public

# AI Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Microservices (Optional Python AI service)
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Email Services (SMTP / Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASSWORD=your_smtp_password_or_key
SMTP_FROM_NAME="Amar Raho Multi-Speciality Hospital"
SMTP_FROM_EMAIL=no-reply@amarrahohospital.com
BREVO_API_KEY=your_brevo_api_key_here

# Telemedicine & Video Calling (Optional Twilio / Agora)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
